# ScriptRunner - Remote Windows Script Execution Platform
# Root Environment Configuration Template (Placeholders only, never commit secrets)

# ─── Supabase Configuration ───────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# ─── Edge Functions Secrets (Set via `supabase secrets set`) ──────────────────
# Signing secret for device JWTs (generate: openssl rand -hex 32)
DEVICE_JWT_SECRET=your-32-byte-hex-jwt-secret

# ─── Agent Configuration (Template for appsettings.json) ──────────────────────
SCRIPTRUNNER_SUPABASE_URL=https://your-project.supabase.co
SCRIPTRUNNER_SUPABASE_ANON_KEY=your-supabase-public-anon-key
SCRIPTRUNNER_DEVICE_ID=00000000-0000-0000-0000-000000000000
SCRIPTRUNNER_DEVICE_API_KEY=your-64-character-hex-device-api-key
