# Supabase Edge Functions – Environment Variables
# These values are set via `supabase secrets set` for cloud deployment.
# For local dev, Supabase CLI injects SUPABASE_URL, SUPABASE_ANON_KEY,
# and SUPABASE_SERVICE_ROLE_KEY automatically.

# Signing secret for device JWTs (generate with: openssl rand -hex 32)
DEVICE_JWT_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# ─── Auto-injected by Supabase (do not set manually) ────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=
